# Use official slim Python runtime image
FROM python:3.13-slim

# Prevent Python from writing .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system build dependencies required for C-extensions and curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency definition file
COPY requirements.txt .

# Install Python packages
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend application source code
COPY config/ ./config/
COPY src/ ./src/
COPY run_api.py .
COPY .env.example .env.example

# Create runtime data directories
RUN mkdir -p data/documents data/chroma_db data/logs data/exports

# Expose API port
EXPOSE 8000

# Start FastAPI server via Uvicorn
CMD ["python", "run_api.py"]
